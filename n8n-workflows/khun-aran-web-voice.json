{
  "name": "Khun Aran-Web-Voice",
  "nodes": [
    {
      "id": "voice-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [240, 400],
      "webhookId": "5d0c2f7e-9a41-4c3b-8e7a-6f1b2c3d4e51",
      "parameters": {
        "httpMethod": "POST",
        "path": "khun-aran-voice",
        "responseMode": "responseNode",
        "options": { "binaryPropertyName": "audio" }
      }
    },
    {
      "id": "voice-auth",
      "name": "Auth Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [464, 400],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "auth1",
              "leftValue": "={{ $json.headers['x-maite-token'] }}",
              "rightValue": "__TOKEN_FROM_AGENT__",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "voice-reject",
      "name": "Reject 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [688, 560],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"unauthorized\" } }}",
        "options": { "responseCode": 401 }
      }
    },
    {
      "id": "voice-check",
      "name": "Check Audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [688, 336],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// OpenAI reconoce el formato por la extensión del nombre: se la ponemos según el tipo que manda el navegador\n// (Chrome/Android graba webm/opus; Safari/iPhone, mp4). El tamaño máximo lo corta nginx antes de llegar aquí.\nconst EXT = { 'audio/webm': 'webm', 'video/webm': 'webm', 'audio/mp4': 'mp4', 'video/mp4': 'mp4', 'audio/x-m4a': 'm4a', 'audio/m4a': 'm4a', 'audio/aac': 'm4a', 'audio/ogg': 'ogg', 'audio/wav': 'wav', 'audio/x-wav': 'wav', 'audio/mpeg': 'mp3' };\nconst item = $input.first();\nconst audio = item.binary && item.binary.audio;\nif (!audio) return [{ json: { ok: false, error: 'no_audio' } }];\nconst mime = String(audio.mimeType || '').split(';')[0].trim().toLowerCase();\nconst ext = EXT[mime];\nif (!ext) return [{ json: { ok: false, error: 'unsupported_format' } }];\naudio.fileName = 'voice.' + ext;\naudio.fileExtension = ext;\naudio.mimeType = mime;\nreturn [{ json: { ok: true }, binary: { audio } }];\n"
      }
    },
    {
      "id": "voice-ok",
      "name": "Audio OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [912, 336],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "ok1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "voice-bad",
      "name": "Reject 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1136, 480],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": $json.error } }}",
        "options": { "responseCode": 400 }
      }
    },
    {
      "id": "voice-transcribe",
      "name": "Transcribe (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1136, 256],
      "onError": "continueErrorOutput",
      "credentials": { "openAiApi": { "id": "meVoCWa85pLdKZvx", "name": "OpenAI - Khun Aran - Voice" } },
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/audio/transcriptions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "audio" },
            { "name": "model", "value": "gpt-4o-mini-transcribe" },
            { "name": "prompt", "value": "Flames, Khun Aran, Koh Samui." }
          ]
        },
        "options": { "timeout": 30000 }
      }
    },
    {
      "id": "voice-respond",
      "name": "Respond Text",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1360, 192],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"text\": String($json.text || '').trim().slice(0, 1500) } }}",
        "options": {}
      }
    },
    {
      "id": "voice-fail",
      "name": "Fail 502",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1360, 368],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"transcription_failed\", \"detail\": String(($json.error && ($json.error.message || $json.error)) || '').slice(0, 200) } }}",
        "options": { "responseCode": 502 }
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Auth Gate", "type": "main", "index": 0 }]] },
    "Auth Gate": { "main": [[{ "node": "Check Audio", "type": "main", "index": 0 }], [{ "node": "Reject 401", "type": "main", "index": 0 }]] },
    "Check Audio": { "main": [[{ "node": "Audio OK?", "type": "main", "index": 0 }]] },
    "Audio OK?": { "main": [[{ "node": "Transcribe (OpenAI)", "type": "main", "index": 0 }], [{ "node": "Reject 400", "type": "main", "index": 0 }]] },
    "Transcribe (OpenAI)": { "main": [[{ "node": "Respond Text", "type": "main", "index": 0 }], [{ "node": "Fail 502", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Bangkok",
    "callerPolicy": "workflowsFromSameOwner",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  }
}
